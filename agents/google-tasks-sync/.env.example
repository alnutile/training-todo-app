# Sync agent env — copy to agents/.env for a local run. agents/.env is gitignored.
# ALL server-only. None of these are VITE_ vars; none belong in the web app.

# Supabase project + SERVICE_ROLE key (bypasses RLS — server-only, never commit)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Whose board to write to. service_role bypasses RLS, so the agent sets user_id
# to this on every row — getting it wrong writes your tasks onto someone else's
# board, which is why it's checked in tests/target-user.test.ts.
#
# Set EITHER of these. The email is the easy one: nobody knows their own UUID,
# and the agent looks it up with the admin API. An explicit id wins if both are
# set. The account has to exist — sign in to the app once first.
SYNC_TARGET_EMAIL=you@example.com
# SYNC_TARGET_USER_ID=your-user-uuid

# Your Google Tasks connection id (from `zapier-sdk list-connections`).
# Not a credential on its own — useless without your Zapier auth.
GOOGLE_TASKS_CONNECTION_ID=your-google-tasks-connection-id

# How many of the most-recently-updated tasks to sync. Default 50 (keeps the
# demo board tidy). Set to 0 to sync everything.
SYNC_LIMIT=50

# Zapier auth on a server (Railway): create with `zapier-sdk create-client-credentials`.
# Locally you can omit these — the SDK uses the token from `zapier-sdk login`.
ZAPIER_CREDENTIALS_CLIENT_ID=your-zapier-client-id
ZAPIER_CREDENTIALS_CLIENT_SECRET=your-zapier-client-secret
