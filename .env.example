# Copy to .env and fill in real values. Only VITE_-prefixed vars reach the
# browser — treat them as PUBLIC. The Supabase anon/publishable key is safe
# client-side.
#
# NEVER put the Supabase service_role key here or in any VITE_ var — it is
# server-only and must never reach the client bundle.
#
# Two ways to fill these in:
#
#   Local Supabase (no cloud project needed) — run `supabase start` and use the
#   API URL and publishable key it prints:
#     VITE_SUPABASE_URL=http://127.0.0.1:54321
#     VITE_SUPABASE_ANON_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
#
#   Hosted Supabase — the project's URL and anon/publishable key, below.
#
# Note: the tests need none of this. They fake the network instead (see
# docs/ci-cd.md), which is why CI is green without a database.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_publishable_key

# ---------------------------------------------------------------------------
# SERVER-ONLY (the Google Tasks sync agent — see agents/google-tasks-sync/).
# NOT used by the web app. Never VITE_-prefixed, never committed. Full list in
# agents/google-tasks-sync/.env.example.
# The service_role key bypasses RLS and must stay server-side only.
# ---------------------------------------------------------------------------
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
